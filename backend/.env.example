# Application Settings
PROJECT_NAME="Dayflow HRMS API"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-dayflow-hrms"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL default, falls back to SQLite if unset or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow_hrms"

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
