# Docker deployment environment (copy to .env before: docker compose up --build)
POSTGRES_DB=dayflow_db
POSTGRES_USER=dayflow_user
POSTGRES_PASSWORD=dayflow_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://dayflow_user:dayflow_password@postgres:5432/dayflow_db

SECRET_KEY=dayflow_insecure_dev_secret_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# Browser-facing API URL (must be reachable from your machine, not the Docker network)
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

BACKEND_PORT=8000
FRONTEND_PORT=5173
