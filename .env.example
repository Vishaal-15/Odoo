# ==============================================================================
# DAYFLOW HRMS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the application:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL (Developer 3 - Database & Infrastructure)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dayflow_db
POSTGRES_USER=dayflow_user
POSTGRES_PASSWORD=dayflow_password

# SQLAlchemy Synchronous Connection String (psycopg2)
DATABASE_URL=postgresql://dayflow_user:dayflow_password@localhost:5432/dayflow_db

# SQLAlchemy Asynchronous Connection String (asyncpg)
ASYNC_DATABASE_URL=postgresql+asyncpg://dayflow_user:dayflow_password@localhost:5432/dayflow_db

# Docker internal network database host (used when backend runs inside docker)
# DATABASE_URL=postgresql://dayflow_user:dayflow_password@postgres:5432/dayflow_db

# ------------------------------------------------------------------------------
# 2. BACKEND & SECURITY (Developer 1 - Backend & Auth)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="Dayflow HRMS"

# JWT Secret Configuration
SECRET_KEY=dayflow_insecure_dev_secret_key_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (Developer 2 - Frontend)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 4. AI & ANALYTICS (Developer 4 - AI & Background Processing)
# ------------------------------------------------------------------------------
ANALYTICS_CACHE_TTL_SECONDS=300
ENABLE_BACKGROUND_TASKS=true
